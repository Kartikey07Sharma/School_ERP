generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InstitutionType {
  SCHOOL
  COLLEGE
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
}

model School {
  id              String          @id @default(uuid())

  name            String
  code            String          @unique

  email           String          @unique
  phone           String          @unique

  address         String?
  logoUrl         String?

  institutionType InstitutionType

  status          SchoolStatus    @default(ACTIVE)

  users           User[]
  students        Student[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([code])
  @@index([email])

  @@map("schools")
}

model User {
  id          String      @id @default(uuid())

  firstName   String
  lastName    String?

  email       String      @unique
  phone       String?     @unique

  password    String

  role        UserRole

  status      UserStatus  @default(ACTIVE)

  // Platform administrators may have no tenant; a migration check requires
  // every non-SUPER_ADMIN account to reference a school.
  schoolId    String?

  school      School?     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  student     Student?

  authVersion Int         @default(0)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([schoolId])

  @@map("users")
}

model Student {
  id                   String        @id @default(uuid())
  admissionNumber      String
  firstName            String
  middleName           String?
  lastName             String
  dateOfBirth          DateTime      @db.Date
  gender               String
  admissionDate        DateTime      @db.Date
  className            String
  section              String
  academicYear         String
  email                String?
  phone                String?
  address              String
  guardianName         String
  guardianRelationship String
  guardianPhone        String
  guardianEmail        String?
  status               StudentStatus @default(ACTIVE)
  schoolId             String
  portalUserId         String?       @unique
  school               School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  portalUser           User?         @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, status])
  @@index([schoolId, className, section, academicYear])
  @@index([schoolId, lastName, firstName])
  @@map("students")
}
