NODE_ENV=development
PORT=5000
TRUST_PROXY_HOPS=0
# For local Node: use your existing PostgreSQL connection string.
# For Docker on Windows with PostgreSQL on the host, use host.docker.internal instead of localhost.
DATABASE_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@localhost:5432/school_erp?schema=public"
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=3000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=600
JWT_ISSUER=school-erp-api
JWT_AUDIENCE=school-erp-client
REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REFRESH_RATE_LIMIT=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
QUEUE_ATTEMPTS=3
QUEUE_COMPLETED_RETENTION=1000
QUEUE_FAILED_RETENTION=5000
QUEUE_WORKER_CONCURRENCY=5




